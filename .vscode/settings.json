{
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--compile-commands-dir=/home/tans/workspace/linux_drivers",
    "--query-driver=/home/tans/workspace/orangepi-build/toolchains/gcc-arm-9.2-2019.12-x86_64-aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-*",
    "--background-index",
    "--header-insertion=never"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "files.associations": {
    "*.h": "c",
    "*.c": "c"
  },
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor" // 预览 Markdown 文件
  }
}
